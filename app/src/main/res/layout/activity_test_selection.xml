<?xml version="1.0" encoding="utf-8"?><ScrollView    xmlns:android="http://schemas.android.com/apk/res/android"    xmlns:app="http://schemas.android.com/apk/res-auto"    android:layout_width="match_parent"    android:layout_height="match_parent"    android:background="#071A33"    android:fillViewport="true">    <LinearLayout        android:layout_width="match_parent"        android:layout_height="wrap_content"        android:orientation="vertical"        android:padding="20dp">        <!-- HEADER -->        <TextView            android:id="@+id/welcomeText"            android:layout_width="wrap_content"            android:layout_height="wrap_content"            android:layout_marginTop="25dp"            android:text="Welcome, Prince!"            android:textColor="#FFFFFF"            android:textSize="30sp"            android:textStyle="bold" />        <TextView            android:layout_width="wrap_content"            android:layout_height="wrap_content"            android:layout_marginTop="6dp"            android:text="What do you want to practice today?"            android:textColor="#AABBD0"            android:textSize="16sp" />        <!-- ROW 1 -->        <LinearLayout            android:layout_width="match_parent"            android:layout_height="150dp"            android:layout_marginTop="28dp"            android:orientation="horizontal">            <com.google.android.material.card.MaterialCardView                android:layout_width="0dp"                android:layout_height="match_parent"                android:layout_weight="1"                android:layout_marginEnd="8dp"                app:cardBackgroundColor="#102D4F"                app:cardCornerRadius="22dp"                app:cardElevation="5dp">                <LinearLayout                    android:id="@+id/dsaButton"                    android:layout_width="match_parent"                    android:layout_height="match_parent"                    android:orientation="vertical"                    android:gravity="center"                    android:clickable="true"                    android:focusable="true">                    <ImageView                        android:layout_width="45dp"                        android:layout_height="45dp"                        android:src="@drawable/ic_dsa"                        android:contentDescription="DSA"                        app:tint="#5CA9FF" />                    <TextView                        android:layout_width="wrap_content"                        android:layout_height="wrap_content"                        android:layout_marginTop="10dp"                        android:text="DSA"                        android:textColor="#FFFFFF"                        android:textSize="20sp"                        android:textStyle="bold" />                    <TextView                        android:layout_width="wrap_content"                        android:layout_height="wrap_content"                        android:text="Data Structures"                        android:textColor="#8EA8C4"                        android:textSize="12sp" />                </LinearLayout>            </com.google.android.material.card.MaterialCardView>            <com.google.android.material.card.MaterialCardView                android:layout_width="0dp"                android:layout_height="match_parent"                android:layout_weight="1"                android:layout_marginStart="8dp"                app:cardBackgroundColor="#132F2B"                app:cardCornerRadius="22dp"                app:cardElevation="5dp">                <LinearLayout                    android:id="@+id/dbmsButton"                    android:layout_width="match_parent"                    android:layout_height="match_parent"                    android:orientation="vertical"                    android:gravity="center"                    android:clickable="true"                    android:focusable="true">                    <ImageView                        android:layout_width="45dp"                        android:layout_height="45dp"                        android:src="@drawable/ic_database"                        android:contentDescription="DBMS"                        app:tint="#42D6A4" />                    <TextView                        android:layout_width="wrap_content"                        android:layout_height="wrap_content"                        android:layout_marginTop="10dp"                        android:text="DBMS"                        android:textColor="#FFFFFF"                        android:textSize="20sp"                        android:textStyle="bold" />                    <TextView                        android:layout_width="wrap_content"                        android:layout_height="wrap_content"                        android:text="Database Systems"                        android:textColor="#8EA8C4"                        android:textSize="12sp" />                </LinearLayout>            </com.google.android.material.card.MaterialCardView>        </LinearLayout>        <!-- ROW 2 -->        <LinearLayout            android:layout_width="match_parent"            android:layout_height="150dp"            android:layout_marginTop="16dp"            android:orientation="horizontal">            <com.google.android.material.card.MaterialCardView                android:layout_width="0dp"                android:layout_height="match_parent"                android:layout_weight="1"                android:layout_marginEnd="8dp"                app:cardBackgroundColor="#302348"                app:cardCornerRadius="22dp"                app:cardElevation="5dp">                <LinearLayout                    android:id="@+id/osButton"                    android:layout_width="match_parent"                    android:layout_height="match_parent"                    android:orientation="vertical"                    android:gravity="center"                    android:clickable="true"                    android:focusable="true">                    <ImageView                        android:layout_width="45dp"                        android:layout_height="45dp"                        android:src="@drawable/ic_os"                        android:contentDescription="Operating System"                        app:tint="#B987FF" />                    <TextView                        android:layout_width="wrap_content"                        android:layout_height="wrap_content"                        android:layout_marginTop="10dp"                        android:text="OS"                        android:textColor="#FFFFFF"                        android:textSize="20sp"                        android:textStyle="bold" />                    <TextView                        android:layout_width="wrap_content"                        android:layout_height="wrap_content"                        android:text="Operating Systems"                        android:textColor="#8EA8C4"                        android:textSize="12sp" />                </LinearLayout>            </com.google.android.material.card.MaterialCardView>            <com.google.android.material.card.MaterialCardView                android:layout_width="0dp"                android:layout_height="match_parent"                android:layout_weight="1"                android:layout_marginStart="8dp"                app:cardBackgroundColor="#39241D"                app:cardCornerRadius="22dp"                app:cardElevation="5dp">                <LinearLayout                    android:id="@+id/cnButton"                    android:layout_width="match_parent"                    android:layout_height="match_parent"                    android:orientation="vertical"                    android:gravity="center"                    android:clickable="true"                    android:focusable="true">                    <ImageView                        android:layout_width="45dp"                        android:layout_height="45dp"                        android:src="@drawable/ic_network"                        android:contentDescription="Computer Networks"                        app:tint="#FF9F5B" />                    <TextView                        android:layout_width="wrap_content"                        android:layout_height="wrap_content"                        android:layout_marginTop="10dp"                        android:text="CN"                        android:textColor="#FFFFFF"                        android:textSize="20sp"                        android:textStyle="bold" />                    <TextView                        android:layout_width="wrap_content"                        android:layout_height="wrap_content"                        android:text="Computer Networks"                        android:textColor="#8EA8C4"                        android:textSize="12sp" />                </LinearLayout>            </com.google.android.material.card.MaterialCardView>        </LinearLayout>        <!-- ROW 3 -->        <LinearLayout            android:layout_width="match_parent"            android:layout_height="150dp"            android:layout_marginTop="16dp"            android:orientation="horizontal">            <com.google.android.material.card.MaterialCardView                android:layout_width="0dp"                android:layout_height="match_parent"                android:layout_weight="1"                android:layout_marginEnd="8dp"                app:cardBackgroundColor="#33283B"                app:cardCornerRadius="22dp"                app:cardElevation="5dp">                <LinearLayout                    android:id="@+id/oopButton"                    android:layout_width="match_parent"                    android:layout_height="match_parent"                    android:orientation="vertical"                    android:gravity="center"                    android:clickable="true"                    android:focusable="true">                    <ImageView                        android:layout_width="45dp"                        android:layout_height="45dp"                        android:src="@drawable/ic_oop"                        android:contentDescription="OOP"                        app:tint="#E58BFF" />                    <TextView                        android:layout_width="wrap_content"                        android:layout_height="wrap_content"                        android:layout_marginTop="10dp"                        android:text="OOP"                        android:textColor="#FFFFFF"                        android:textSize="20sp"                        android:textStyle="bold" />                    <TextView                        android:layout_width="wrap_content"                        android:layout_height="wrap_content"                        android:text="Object Oriented Programming"                        android:textColor="#8EA8C4"                        android:textSize="11sp" />                </LinearLayout>            </com.google.android.material.card.MaterialCardView>            <com.google.android.material.card.MaterialCardView                android:layout_width="0dp"                android:layout_height="match_parent"                android:layout_weight="1"                android:layout_marginStart="8dp"                app:cardBackgroundColor="#352C18"                app:cardCornerRadius="22dp"                app:cardElevation="5dp">                <LinearLayout                    android:id="@+id/coaButton"                    android:layout_width="match_parent"                    android:layout_height="match_parent"                    android:orientation="vertical"                    android:gravity="center"                    android:clickable="true"                    android:focusable="true">                    <ImageView                        android:layout_width="45dp"                        android:layout_height="45dp"                        android:src="@drawable/ic_cpu"                        android:contentDescription="COA"                        app:tint="#FFD166" />                    <TextView                        android:layout_width="wrap_content"                        android:layout_height="wrap_content"                        android:layout_marginTop="10dp"                        android:text="COA"                        android:textColor="#FFFFFF"                        android:textSize="20sp"                        android:textStyle="bold" />                    <TextView                        android:layout_width="wrap_content"                        android:layout_height="wrap_content"                        android:text="Computer Architecture"                        android:textColor="#8EA8C4"                        android:textSize="12sp" />                </LinearLayout>            </com.google.android.material.card.MaterialCardView>        </LinearLayout>        <!-- ROW 4 -->        <LinearLayout            android:layout_width="match_parent"            android:layout_height="150dp"            android:layout_marginTop="16dp"            android:layout_marginBottom="25dp"            android:orientation="horizontal">            <com.google.android.material.card.MaterialCardView                android:layout_width="0dp"                android:layout_height="match_parent"                android:layout_weight="1"                android:layout_marginEnd="8dp"                app:cardBackgroundColor="#19363A"                app:cardCornerRadius="22dp"                app:cardElevation="5dp">                <LinearLayout                    android:id="@+id/daaButton"                    android:layout_width="match_parent"                    android:layout_height="match_parent"                    android:orientation="vertical"                    android:gravity="center"                    android:clickable="true"                    android:focusable="true">                    <ImageView                        android:layout_width="45dp"                        android:layout_height="45dp"                        android:src="@drawable/ic_algorithm"                        android:contentDescription="DAA"                        app:tint="#4DD0E1" />                    <TextView                        android:layout_width="wrap_content"                        android:layout_height="wrap_content"                        android:layout_marginTop="10dp"                        android:text="DAA"                        android:textColor="#FFFFFF"                        android:textSize="20sp"                        android:textStyle="bold" />                    <TextView                        android:layout_width="wrap_content"                        android:layout_height="wrap_content"                        android:text="Algorithms"                        android:textColor="#8EA8C4"                        android:textSize="12sp" />                </LinearLayout>            </com.google.android.material.card.MaterialCardView>            <com.google.android.material.card.MaterialCardView                android:layout_width="0dp"                android:layout_height="match_parent"                android:layout_weight="1"                android:layout_marginStart="8dp"                app:cardBackgroundColor="#39202B"                app:cardCornerRadius="22dp"                app:cardElevation="5dp">                <LinearLayout                    android:id="@+id/seButton"                    android:layout_width="match_parent"                    android:layout_height="match_parent"                    android:orientation="vertical"                    android:gravity="center"                    android:clickable="true"                    android:focusable="true">                    <ImageView                        android:layout_width="45dp"                        android:layout_height="45dp"                        android:src="@drawable/ic_software"                        android:contentDescription="Software Engineering"                        app:tint="#FF6B9D" />                    <TextView                        android:layout_width="wrap_content"                        android:layout_height="wrap_content"                        android:layout_marginTop="10dp"                        android:text="Software Engineering"                        android:textColor="#FFFFFF"                        android:textSize="16sp"                        android:textStyle="bold" />                    <TextView                        android:layout_width="wrap_content"                        android:layout_height="wrap_content"                        android:text="Software Development"                        android:textColor="#8EA8C4"                        android:textSize="11sp" />                </LinearLayout>            </com.google.android.material.card.MaterialCardView>        </LinearLayout>    </LinearLayout></ScrollView>